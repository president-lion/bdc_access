# --- nothing of the game itself is in this repository ----------------------
# the patched game data, and the original beside it
build/
*.win
*.win.*

# decompiled GML, disassembly, symbol and string dumps, extracted runner
# tables, Ghidra projects, exported sprites and contact sheets - all of it is
# the game's own content, read to write the mod. None of it belongs here.
research/
*.gml

# --- research tooling, kept locally --------------------------------------
# gscripts holds the probes, dumpers and exporters written to read the game
# apart. Only the three scripts that make and check the mod are published.
gscripts/*
!gscripts/inject_a11y.csx
!gscripts/verify_a11y.csx
!gscripts/sweep_safety.csx

# --- the retired injection-based build, kept locally as a record ----------
Reloaded-II/
src/BDC.Accessibility/

# upstream Prism clone; the built DLL is committed under bin/
src/prism/

# the UndertaleModTool CLI - fetched, not authored, and 118 MB
tools/

# --- build leftovers -------------------------------------------------------
*.obj
*.exp
*.lib
*.pdb
bin/Release/
obj/

# the assembled release payload - built by make_release.bat, and 118 MB of it
# is the third-party patcher
release/
*.zip
